  "@graph": [
    {
      "@id": "https://orcid.org/0000-0002-7904-3892",
      "@type": "schema:Person",
      "schema:affiliation": [
        "Digital Humanities (Image/Object), Friedrich-Schiller-University Jena",
        "Research Center DIGITAL ORGANOLOGY, Leipzig University"
      ],
      "schema:name": "Dominik Ukolov"
    },
    {
      "@id": "https://w3id.org/modavis/omaro/ontology",
      "@type": "owl:Ontology",
      "dcterms:creator": {
        "@id": "https://orcid.org/0000-0002-7904-3892"
      },
      "dcterms:description": {
        "@language": "en",
        "@value": "An ontology for representing contextualized organological assertions, their perspectives and applicability, supporting evidence, authority, review decisions, and governed projections without collapsing disagreement."
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:publisher": "MODAVIS Project",
      "dcterms:relation": [
        {
          "@id": "https://w3id.org/modavis/ontology/0.1.0"
        },
        {
          "@id": "https://w3id.org/modavis/vao/0.4.0/"
        }
      ],
      "dcterms:title": {
        "@language": "en",
        "@value": "OMARO: Ontology for Multiperspectivity, Assertions, and Review in Organology"
      },
      "owl:versionIRI": {
        "@id": "https://w3id.org/modavis/omaro/ontology/2.2.0"
      },
      "owl:versionInfo": "2.2.0",
      "vann:preferredNamespacePrefix": "omaro",
      "vann:preferredNamespaceUri": {
        "@id": "omaro:"
      }
    },
    {
      "@id": "https://w3id.org/modavis/omaro/ontology/2.2.0",
      "@type": "owl:Ontology",
      "dcterms:isVersionOf": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "owl:versionInfo": "2.2.0"
    },
    {
      "@id": "omaro:ApplicabilityScope",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A resource stating whether and under which communities, places, periods, uses, techniques, configurations, languages, or times an assertion applies."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "applicability scope"
      },
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      }
    },
    {
      "@id": "omaro:AuthorityAssignment",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A time-bounded mandate connecting an agent to roles, subject matter, communities, and validation dimensions."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "authority assignment"
      },
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      }
    },
    {
      "@id": "omaro:ClassificationAssertion",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "An occurrence-level claim that a named target is classified by a concept under a recorded perspective, scope, method, and provenance."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "classification assertion"
      },
      "rdfs:subClassOf": [
        {
          "@id": "prov:Entity"
        },
        {
          "@id": "rdf:Statement"
        }
      ]
    },
    {
      "@id": "omaro:ClassificationAssignment",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "owl:disjointWith": [
        {
          "@id": "omaro:ClassificationAssertion"
        },
        {
          "@id": "omaro:ConceptRelationAssertion"
        },
        {
          "@id": "omaro:LabelAssertion"
        },
        {
          "@id": "omaro:NoteAssertion"
        },
        {
          "@id": "omaro:ReviewDecision"
        }
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "The provenance-bearing activity that applies a named classification to a target and generates a distinct classification assertion entity."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "classification assignment"
      },
      "rdfs:subClassOf": [
        {
          "@id": "crm:E17_Type_Assignment"
        },
        {
          "@id": "prov:Activity"
        }
      ]
    },
    {
      "@id": "omaro:ClassificationCriterion",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A governed description of an observable organological basis and any documented inference logic used by an assignment."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "classification criterion"
      },
      "rdfs:subClassOf": {
        "@id": "prov:Plan"
      }
    },
    {
      "@id": "omaro:ClassificationExpression",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "An ordered compound classification expression whose component targets and suffix scope are explicit or explicitly unresolved."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "classification expression"
      },
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      }
    },
    {
      "@id": "omaro:ClassificationExpressionMember",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "One ordered member of a compound classification expression."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "classification expression member"
      },
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      }
    },
    {
      "@id": "omaro:ConceptRelationAssertion",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A qualified structural relation or purpose-specific mapping claim between two concepts."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "concept relation assertion"
      },
      "rdfs:subClassOf": [
        {
          "@id": "prov:Entity"
        },
        {
          "@id": "rdf:Statement"
        }
      ]
    },
    {
      "@id": "omaro:ConditionState",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A time-bounded condition of an object or component, kept distinct from the configuration it was intended to have."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "condition state"
      },
      "rdfs:subClassOf": {
        "@id": "omaro:OrganologicalTarget"
      }
    },
    {
      "@id": "omaro:Evidence",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A structured citation, resource, or note directionally related to an assertion, observation, criterion, or review decision."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "evidence record"
      },
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      }
    },
    {
      "@id": "omaro:FunctionalModule",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A functional subsystem or configurable module participating in sound production or control."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "functional module"
      },
      "rdfs:subClassOf": {
        "@id": "omaro:OrganologicalTarget"
      }
    },
    {
      "@id": "omaro:InstrumentComponent",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A physical component that can be observed or classified without propagating its class to the whole object."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "instrument component"
      },
      "rdfs:subClassOf": {
        "@id": "omaro:OrganologicalTarget"
      }
    },
    {
      "@id": "omaro:InstrumentConfiguration",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A time-bounded arrangement of an object, components, modules, accessories, or signal path that may receive its own classification."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "instrument configuration"
      },
      "rdfs:subClassOf": {
        "@id": "omaro:OrganologicalTarget"
      }
    },
    {
      "@id": "omaro:LabelAssertion",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A contextualized assertion that assigns a lexical label to a concept."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "label assertion"
      },
      "rdfs:subClassOf": [
        {
          "@id": "prov:Entity"
        },
        {
          "@id": "rdf:Statement"
        }
      ]
    },
    {
      "@id": "omaro:LabelProfile",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A conservative linguistic and display profile attached to one assertion-scoped label resource."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "label linguistic profile"
      },
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      }
    },
    {
      "@id": "omaro:NoteAssertion",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A contextualized assertion that assigns a definition or other SKOS note to a concept."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "note assertion"
      },
      "rdfs:subClassOf": [
        {
          "@id": "prov:Entity"
        },
        {
          "@id": "rdf:Statement"
        }
      ]
    },
    {
      "@id": "omaro:ObservationAssessment",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A record of whether an organological property was observed or applicable; it is not itself an observation activity when the status is non-observation or non-applicability."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "observation assessment"
      }
    },
    {
      "@id": "omaro:ObservationResult",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A categorical, literal, quantity, or range result of an organological observation."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "observation result"
      },
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      }
    },
    {
      "@id": "omaro:OrganologicalObservation",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "An observation or measurement of a target or part, recording property, result, procedure, observer, and time before classification inference."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "organological observation"
      },
      "rdfs:subClassOf": [
        {
          "@id": "crmsci:S27_Observation"
        },
        {
          "@id": "omaro:ObservationAssessment"
        },
        {
          "@id": "sosa:Observation"
        }
      ]
    },
    {
      "@id": "omaro:OrganologicalTarget",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A target whose physical identity, component structure, configuration, state, sounding realization, or performance role may be described independently."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "organological target"
      }
    },
    {
      "@id": "omaro:Perspective",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "An explicit source, institutional, scholarly, community, curatorial, historical, or technical standpoint from which an assertion is made or evaluated."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "named perspective"
      },
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      }
    },
    {
      "@id": "omaro:ProjectionPolicy",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A versioned rule set governing which qualified assertions may appear in a named graph or simplified direct view."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "projection policy"
      },
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      }
    },
    {
      "@id": "omaro:ProtocolApplication",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "The application of an authoritative cultural or community protocol to specified resources, separate from legal rights and epistemic review."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "protocol application"
      },
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      }
    },
    {
      "@id": "omaro:QualityFinding",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "An occurrence of a quality rule against a target assertion, retained as a review signal."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "quality finding"
      },
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      }
    },
    {
      "@id": "omaro:QualityRule",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A deterministic validation or review-signal rule that has no human review effect by itself."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "quality rule"
      }
    },
    {
      "@id": "omaro:ReviewDecision",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "The durable outcome entity generated by a review event; lifecycle links apply to decisions rather than to the activities that created them."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "review decision"
      },
      "rdfs:subClassOf": {
        "@id": "prov:Entity"
      }
    },
    {
      "@id": "omaro:ReviewEvent",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "owl:disjointWith": [
        {
          "@id": "omaro:ClassificationAssertion"
        },
        {
          "@id": "omaro:ConceptRelationAssertion"
        },
        {
          "@id": "omaro:LabelAssertion"
        },
        {
          "@id": "omaro:NoteAssertion"
        },
        {
          "@id": "omaro:ReviewDecision"
        }
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A provenance-bearing review activity that evaluates an assertion and generates a distinct review decision."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "review event"
      },
      "rdfs:subClassOf": {
        "@id": "prov:Activity"
      }
    },
    {
      "@id": "omaro:ReviewRequirement",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A minimum reviewer-authority, validation-dimension, outcome, and independence condition used by a projection policy."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "review requirement"
      }
    },
    {
      "@id": "omaro:ReviewStatus",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A controlled lifecycle status used for assertions without collapsing separate review decisions."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "review status"
      }
    },
    {
      "@id": "omaro:SoundingRealization",
      "@type": [
        "owl:Class",
        "rdfs:Class"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A particular occurrence or configuration of sounding, distinct from a physical artefact realization in other music ontologies."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/modavis/omaro/ontology"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "sounding realization"
      },
      "rdfs:subClassOf": {
        "@id": "omaro:OrganologicalTarget"
      }
    },
    {
      "@id": "omaro:UseDecision",
      "@type": [
        "owl:Class",
