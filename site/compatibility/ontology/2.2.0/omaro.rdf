o the mandate that authorizes it.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">authority assignment</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#AuthorityAssignment"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#authorityBasis"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links an authority assignment to the resource documenting its mandate.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">authority basis</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#authorityRole"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the controlled authority role granted by a mandate.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">authority role</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#categoricalValue"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links an observation result to a controlled categorical value.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">categorical value</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#classificationAssignment"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links an assertion to the distinct assignment activity that generated it.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">classification assignment</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#ClassificationAssignment"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#classificationCriterion"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies a governed criterion applied when producing a classification assertion.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">classification criterion</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#ClassificationCriterion"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#classificationExpression"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links an assertion or source concept to an ordered compound classification expression.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">classification expression</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#ClassificationExpression"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#classificationMethod"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the method used to produce a classification or concept-relation assertion.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">classification method</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#classificationScheme"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the concept scheme used by a classification assertion.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">classification scheme</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#classifiedAs"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a classification assertion target to the classification concept asserted for it.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">classified as</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#combinationOperator"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the controlled operator joining the members of a classification expression.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">combination operator</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#componentOf"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a component to the target of which it is a physical or functional part.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">component of</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#OrganologicalTarget"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#componentRole"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the evidenced role of a component in a configuration.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">component role</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#conditionStateOf"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a condition state to the target whose condition it records.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">condition state of</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#OrganologicalTarget"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#conferredBy"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the agent that granted an authority assignment.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">conferred by</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Agent"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#configurationOf"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a configuration to the persistent target configured in that state.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">configuration of</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#OrganologicalTarget"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#consentAssessedBy"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the agent responsible for the separately recorded consent determination; it does not itself prove valid consent.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">consent assessed by</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Agent"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#consentRecord"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a use decision to a public-safe authorization reference for any required individual consent.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">consent record</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#consentStatus"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records whether required individual consent is documented, not required, unknown, withheld, or withdrawn.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">consent status</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#contextMatchRequired"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">States whether a projection policy requires supplied context to match every applicable scope constraint.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">context match required</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#coveredAction"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies a use action that an authority mandate explicitly empowers its holder to decide.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">covered action</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#coveredValidationDimension"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records a validation dimension covered by an authority assignment.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">covered validation dimension</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#criterionStatus"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the controlled lifecycle status of a classification criterion.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">criterion status</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#criterionType"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the organological facet addressed by a classification criterion.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">criterion type</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#decidedBy"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the authorized agent responsible for a use decision.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">decided by</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Agent"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#decisionMethod"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the community- or authority-defined procedure by which a use decision was reached.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">decision method</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#decisionStatus"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records whether a review decision is active, suspended, superseded, or otherwise lifecycle-limited.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">decision status</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#defaultScriptSubtag"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records a registry-supported default script subtag without treating it as an observed script.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">default script subtag</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#delegationPermitted"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">States whether an authority assignment permits the authorized agent to delegate its mandate.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">delegation permitted</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#directAssertion"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">States whether a projection policy may emit simplified direct RDF assertions.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">direct assertion</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#displayPolicy"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records how a contextualized label may be displayed.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">display policy</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#eligibleReviewerAuthority"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records a reviewer-authority code eligible to satisfy a requirement or veto rule.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">eligible reviewer authority</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#eligibleStance"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records a claim stance eligible for a projection policy.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">eligible stance</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#enforcementMode"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies whether a protocol is advisory, requires human decision, or has an authorized machine-enforceable rule.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">enforcement mode</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#evidenceRelation"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies whether evidence supports, opposes, qualifies, or documents a claim or decision.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">evidence relation</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#evidenceType"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the controlled category of an evidence resource.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">evidence type</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#explicitScriptSubtag"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the explicit BCP 47 script subtag supplied with a label.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">explicit script subtag</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#extensionSubtag"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records one BCP 47 extension subtag supplied with a label.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">extension subtag</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#generatedAssertion"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links an assignment activity to the assertion entity it generated.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">generated assertion</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#ClassificationAssertion"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#governance"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a concept scheme or perspective to its governance resource.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">governance</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#graphRole"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the intended role of the graph produced by a projection policy.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">graph role</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#hasApplicabilityScope"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a qualified assertion, mandate, or review decision to an applicability scope.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">has applicability scope</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#ApplicabilityScope"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#hasCommonOrInheritedCharacters"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">States whether a label contains Unicode Common or Inherited script characters.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">has common or inherited characters</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#hasComponent"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a target or configuration to one of its physical components.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">has component</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#OrganologicalTarget"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#hasEvidence"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links an assertion or review decision to a structured evidence record.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">has evidence</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#Evidence"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#hasExpressionMember"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a compound classification expression to one ordered member.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">has expression member</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#ClassificationExpressionMember"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#hasFunctionalModule"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a target or configuration to a functional subsystem or module.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">has functional module</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#FunctionalModule"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#heldBy"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the agent responsible for a named perspective.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">held by</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Agent"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#includesSourceLayer"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">States whether a projection policy includes preserved source statements.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">includes source layer</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#inferenceLogic"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the documented inference logic applied by a classification assignment.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">inference logic</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#integrityAttestation"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links to a public-safe external attestation when protocol integrity was not recomputed from a bundled artifact.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">integrity attestation</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#integrityVerificationMethod"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Distinguishes locally recomputed SHA-256 verification from an identified external attestation or no verification.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">integrity verification method</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#intendedPlayingTechnique"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies an intended or prescribed technique without claiming that it occurred.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">intended playing technique</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#issuedBy"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the authority or community agent that issued an applied protocol.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">issued by</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Agent"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#labelProfile"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links an assertion-scoped lexical resource to its conservative linguistic profile.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">label profile</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#LabelProfile"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#labelResource"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a label assertion or profile to its assertion-scoped SKOS-XL label resource.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">label resource</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2008/05/skos-xl#Label"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#languageRegistry"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the versioned language registry used to validate a label tag.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">language registry</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Entity"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#languageTagStatus"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the validation and canonicalization status of a submitted language tag.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">language tag status</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#languageVariety"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies an evidenced language variety associated with a label profile.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">language variety</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#legalBasis"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a use decision to a public-safe reference documenting the independently assessed legal basis.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">legal basis</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#legalBasisAssessedBy"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the agent responsible for the separately recorded legal-basis determination; it does not itself prove legal compliance.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">legal basis assessed by</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Agent"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#legalBasisStatus"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records whether the legal basis is documented, not required, unknown, or blocking publication.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">legal basis status</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#localSuffixNotation"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Preserves suffix notation explicitly scoped to one expression member.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">local suffix notation</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#mapping-purpose-data-transformation"><rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdf:type><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><skos:definition xmlns:skos="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Suitability as an input to an explicitly reviewed data transformation; the declaration does not guarantee a lossless conversion.</skos:definition><skos:inScheme xmlns:skos="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://w3id.org/modavis/omaro#vocabulary-mapping-purpose"></skos:inScheme><skos:notation xmlns:skos="http://www.w3.org/2004/02/skos/core#">data-transformation</skos:notation><skos:prefLabel xmlns:skos="http://www.w3.org/2004/02/skos/core#" xml:lang="en">data transformation</skos:prefLabel><skos:scopeNote xmlns:skos="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A mapping-purpose declaration states intended operational suitability. It is not a licence, permission, cultural authorization, or substitute for an applicable OMARO use decision and protocol.</skos:scopeNote></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#mapping-purpose-display-navigation"><rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdf:type><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><skos:definition xmlns:skos="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Suitability for presenting a human-readable navigation link between the mapped concepts under the assertion's stated qualifications.</skos:definition><skos:inScheme xmlns:skos="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://w3id.org/modavis/omaro#vocabulary-mapping-purpose"></skos:inScheme><skos:notation xmlns:skos="http://www.w3.org/2004/02/skos/core#">display-navigation</skos:notation><skos:prefLabel xmlns:skos="http://www.w3.org/2004/02/skos/core#" xml:lang="en">display navigation</skos:prefLabel><skos:scopeNote xmlns:skos="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A mapping-purpose declaration states intended operational suitability. It is not a licence, permission, cultural authorization, or substitute for an applicable OMARO use decision and protocol.</skos:scopeNote></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#mapping-purpose-query-expansion"><rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdf:type><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><skos:definition xmlns:skos="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Suitability for expanding a retrieval query across the mapped concepts under the assertion's stated qualifications.</skos:definition><skos:inScheme xmlns:skos="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://w3id.org/modavis/omaro#vocabulary-mapping-purpose"></skos:inScheme><skos:notation xmlns:skos="http://www.w3.org/2004/02/skos/core#">query-expansion</skos:notation><skos:prefLabel xmlns:skos="http://www.w3.org/2004/02/skos/core#" xml:lang="en">query expansion</skos:prefLabel><skos:scopeNote xmlns:skos="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A mapping-purpose declaration states intended operational suitability. It is not a licence, permission, cultural authorization, or substitute for an applicable OMARO use decision and protocol.</skos:scopeNote></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#mapping-purpose-scholarly-comparison"><rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdf:type><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><skos:definition xmlns:skos="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Suitability for comparative research across the mapped concepts or classification systems under the assertion's stated qualifications.</skos:definition><skos:inScheme xmlns:skos="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://w3id.org/modavis/omaro#vocabulary-mapping-purpose"></skos:inScheme><skos:notation xmlns:skos="http://www.w3.org/2004/02/skos/core#">scholarly-comparison</skos:notation><skos:prefLabel xmlns:skos="http://www.w3.org/2004/02/skos/core#" xml:lang="en">scholarly comparison</skos:prefLabel><skos:scopeNote xmlns:skos="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A mapping-purpose declaration states intended operational suitability. It is not a licence, permission, cultural authorization, or substitute for an applicable OMARO use decision and protocol.</skos:scopeNote></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#mappingPurpose"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies an operation for which a qualified SKOS mapping is stated to be suitable; it does not grant permission or establish cultural authorization.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">mapping purpose</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#maximumValue"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the maximum numeric value of a range observation result.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">maximum value</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#memberAssertion"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links an expression member to the qualified assertion it groups.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">member assertion</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#ClassificationAssertion"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#memberClassification"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links an expression member to its classification concept.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">member classification</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#memberNotation"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Preserves the source notation of one expression member.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">member notation</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#memberTarget"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links an expression member to the component, configuration, or event it classifies.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">member target</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#OrganologicalTarget"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#minimumIndependentReviewers"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">States the minimum number of independent authorized reviewers required by a policy or review requirement.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">minimum independent reviewers</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#integer"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#minimumValue"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the minimum numeric value of a range observation result.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">minimum value</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#normalizedForm"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the project-normalized lexical form while preserving the submitted form separately.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">normalized form</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#notationGrammar"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the versioned grammar used to parse a classification expression.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">notation grammar</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#notationLiteral"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Preserves a complete classification expression exactly as supplied by its source.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">notation literal</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#numericValue"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the numeric value of a quantity observation result.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">numeric value</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#observableProperty"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies a property that a classification criterion expects to be observed.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">observable property</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#observedScript"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records a Unicode Script code observed in the characters of a label.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">observed script</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#parseStatus"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies whether expression structure is merely tokenized or expert interpreted.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">parse status</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#performanceEvent"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a sounding realization or configured target to its performance event.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">performance event</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#OrganologicalTarget"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#perspective"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links an assertion, scope, or review decision to the perspective under which it is expressed.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">perspective</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#Perspective"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#perspectiveType"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the controlled category of a named perspective.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">perspective type</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#policyVersion"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the semantic version of a projection policy.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">policy version</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#primaryLanguageSubtag"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the primary language subtag parsed from a submitted language tag.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">primary language subtag</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#privateUseSubtag"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records one BCP 47 private-use subtag supplied with a label.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">private use subtag</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#pronunciation"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records an evidenced textual pronunciation associated with a label profile.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">pronunciation</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#protocol"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a protocol application to the authoritative external or community protocol resource.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">protocol</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#protocolApplication"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a governed resource or use decision to an applicable protocol record.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">protocol application</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#ProtocolApplication"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#protocolArtifactPath"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the safe dataset-relative path of a bundled protocol representation whose SHA-256 digest was recomputed.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">protocol artifact path</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#protocolIntegritySha256"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the lowercase SHA-256 digest used to verify the resolved protocol representation.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">protocol integrity sha256</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#protocolResolutionStatus"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records whether the referenced protocol was resolved and integrity-verified for this application.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">protocol resolution status</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#protocolStatus"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the controlled lifecycle status of a protocol application.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">protocol status</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#protocolType"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the externally governed type of a cultural protocol without locally imitating it.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">protocol type</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#qualityRule"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a quality finding to the deterministic rule that produced it.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">quality rule</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#QualityRule"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#rationale"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the explanatory rationale supplied with a review decision.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">rationale</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#realizesInstrumentConcept"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a physical or configured target to an instrument concept it realizes in context.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">realizes instrument concept</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#regionSubtag"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the region subtag parsed from a submitted language tag.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">region subtag</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#reinstatesDecision"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a review event to a suspended decision it explicitly restores.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">reinstates decision</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#ReviewDecision"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#representsCommunity"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies a community explicitly represented by a perspective, mandate, or review decision.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">represents community</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Agent"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#requiredReviewOutcome"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records an outcome that can satisfy a projection-policy review requirement.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">required review outcome</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#resultKind"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records whether an observation result is categorical, literal, quantitative, or a range.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">result kind</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#reviewDecision"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a review event to the durable decision entity it generated.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">review decision</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#ReviewDecision"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#reviewEffect"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records whether a quality signal changes review state; automated OMARO findings use none.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">review effect</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#reviewMethod"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the method used to reach one review decision.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">review method</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#reviewOutcome"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the non-collapsed outcome of one review event.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">review outcome</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#reviewRequirement"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a projection policy to a declarative review requirement.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">review requirement</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#ReviewRequirement"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#reviewStatus"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records a compatibility code for the lifecycle status of an assertion.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">review status</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#reviewStatusResource"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links an assertion to its controlled review-status resource.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">review status resource</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#ReviewStatus"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#reviewerAuthority"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the authority role under which a reviewer made a decision.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">reviewer authority</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#revocationEffect"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records whether revocation of a mandate is prospective or retroactive.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">revocation effect</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#revocationEvent"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links an authority assignment to the resource documenting its revocation.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">revocation event</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#schemePerspective"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a concept scheme to the perspective under which it is maintained or presented.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">scheme perspective</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#Perspective"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#schemeStatus"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the lifecycle status of a registered concept scheme.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">scheme status</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#schemeType"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the controlled category of a registered concept scheme.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">scheme type</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#schemeVersion"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the version of a concept scheme used by an assertion.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">scheme version</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#scopeMode"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">States the epistemic mode of an applicability scope, including explicit applicability and documented uncertainty.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">scope mode</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#scriptObservationMethod"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the versioned method used to observe Unicode Script values.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">script observation method</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#scriptRegistry"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the versioned Unicode Script registry used by a label profile.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">script registry</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Entity"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#searchPolicy"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records whether and with what warning a contextualized label may be indexed.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">search policy</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#sequenceIndex"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the one-based order of a member in a classification expression.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">sequence index</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#sharedSuffixNotation"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Preserves suffix notation explicitly documented as applying to several expression members.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">shared suffix notation</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#skosProjectionStatus"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records whether a label assertion is projected to direct SKOS and SKOS-XL links.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">skos projection status</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#sourceLabelAssertion"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a label profile to the source-qualified label assertion from which it was derived.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">source label assertion</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#LabelAssertion"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#sourceLayer"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the named provenance layer to which a source record belongs.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">source layer</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#sourcePredicate"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the predicate used by a preserved source statement before qualified projection.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">source predicate</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#sourceRecord"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a project record to the versioned source snapshot from which it was asserted or derived.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">source record</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#Entity"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#stance"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the asserted, proposed, disputed, rejected, or superseded position of a claim.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">stance</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#subjectMatter"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies exact subject matter covered by an authority assignment.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">subject matter</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#submittedLanguageTag"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the language tag exactly as supplied by the source.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">submitted language tag</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#supersedesDecision"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a review event to a decision it permanently supersedes.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">supersedes decision</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#ReviewDecision"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#supersedesProtocolApplication"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a protocol application to the earlier application that it replaces.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">supersedes protocol application</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#ProtocolApplication"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#supersedesUseDecision"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a use decision to the earlier use decision that it replaces.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">supersedes use decision</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#UseDecision"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#supportsClassification"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a criterion to a classification concept that it can support under its documented inference logic.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">supports classification</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#suspendsDecision"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a review event to a decision it temporarily suspends.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">suspends decision</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#ReviewDecision"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#targetAssertion"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the assertion evaluated by a finding or review event.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">target assertion</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#targetKind"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the controlled kind of an organological target.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">target kind</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#targetResource"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies a resource governed by a protocol application or use decision.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">target resource</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#targetType"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the ontological level of the target described by a classification assertion.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">target type</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#temporalEnd"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the end of subject-matter applicability as an instant.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">temporal end</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#temporalStart"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the start of subject-matter applicability as an instant.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">temporal start</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#termRole"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records an evidenced controlled lexical role such as endonym, exonym, or historical name.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">term role</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#tolerance"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the stated tolerance associated with a quantitative result.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">tolerance</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#transcriptionSystem"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies an evidenced transcription system used for a label.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">transcription system</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#translationStatus"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the evidence status of a label as a translation or translingual form.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">translation status</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#transliterationSystem"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies an evidenced transliteration system used for a label.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">transliteration system</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#uncertainty"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records measurement or observational uncertainty without treating it as epistemic or cultural authority.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">uncertainty</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#underProjectionPolicy"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links an assertion to a projection policy in which it may be evaluated.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">under projection policy</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#ProjectionPolicy"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#unit"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a quantitative result to a unit resource, normally from QUDT.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">unit</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#unknownScopeBehavior"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">States whether a projection includes, excludes, or warns about assertions whose applicability is unresolved.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">unknown scope behavior</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#useAction"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies an action such as display, index, export, train, or commercialize governed by a use decision.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">use action</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#useAudience"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies an audience to which a use decision applies.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">use audience</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#useDecision"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the granted, refused, withheld, or withdrawn state of a use decision.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">use decision</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#useDecisionStatus"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the controlled lifecycle status of a use decision record.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">use decision status</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#usePurpose"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies a purpose to which a use decision applies.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">use purpose</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#usedAssessment"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a classification assignment to an observation assessment used as a premise, including an explicit non-observation or non-applicability assessment.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">used assessment</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#ObservationAssessment"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#usedObservation"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a classification assignment to an observation used as a premise.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">used observation</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#OrganologicalObservation"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#usedProcedure"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the procedure used by an observation or prescribed by a criterion.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">used procedure</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#validFrom"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the start instant of a claim, perspective, mandate, or decision lifecycle.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">valid from</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#validUntil"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the end instant of a claim, perspective, mandate, or decision lifecycle.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">valid until</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#validationDimension"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records the referential, linguistic, community, historical, scholarly, ethical, or rights dimension addressed.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">validation dimension</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#variantSubtag"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records one BCP 47 variant subtag supplied with a label.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">variant subtag</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#vetoOutcome"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Records a review outcome that triggers a projection-policy veto rule.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">veto outcome</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#vetoRule"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links a projection policy to a declarative veto rule.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">veto rule</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#VetoRule"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#vocabulary-mapping-purpose"><rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"></rdf:type><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><skos:prefLabel xmlns:skos="http://www.w3.org/2004/02/skos/core#" xml:lang="en">mapping purpose vocabulary</skos:prefLabel></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#writingSystem"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies an evidenced writing-system resource associated with a label profile.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">writing system</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro/ontology"><dcterms:creator xmlns:dcterms="http://purl.org/dc/terms/" rdf:resource="https://orcid.org/0000-0002-7904-3892"></dcterms:creator><dcterms:description xmlns:dcterms="http://purl.org/dc/terms/" xml:lang="en">An ontology for representing contextualized organological assertions, their perspectives and applicability, supporting evidence, authority, review decisions, and governed projections without collapsing disagreement.</dcterms:description><dcterms:license xmlns:dcterms="http://purl.org/dc/terms/" rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"></dcterms:license><dcterms:publisher xmlns:dcterms="http://purl.org/dc/terms/">MODAVIS Project</dcterms:publisher><dcterms:relation xmlns:dcterms="http://purl.org/dc/terms/" rdf:resource="https://w3id.org/modavis/ontology/0.1.0"></dcterms:relation><dcterms:relation xmlns:dcterms="http://purl.org/dc/terms/" rdf:resource="https://w3id.org/modavis/vao/0.4.0/"></dcterms:relation><dcterms:title xmlns:dcterms="http://purl.org/dc/terms/" xml:lang="en">OMARO: Ontology for Multiperspectivity, Assertions, and Review in Organology</dcterms:title><vann:preferredNamespacePrefix xmlns:vann="http://purl.org/vocab/vann/">omaro</vann:preferredNamespacePrefix><vann:preferredNamespaceUri xmlns:vann="http://purl.org/vocab/vann/" rdf:resource="https://w3id.org/modavis/omaro#"></vann:preferredNamespaceUri><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"></rdf:type><owl:versionIRI xmlns:owl="http://www.w3.org/2002/07/owl#" rdf:resource="https://w3id.org/modavis/omaro/ontology/2.2.0"></owl:versionIRI><owl:versionInfo xmlns:owl="http://www.w3.org/2002/07/owl#">2.2.0</owl:versionInfo></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro/ontology/2.2.0"><dcterms:isVersionOf xmlns:dcterms="http://purl.org/dc/terms/" rdf:resource="https://w3id.org/modavis/omaro/ontology"></dcterms:isVersionOf><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"></rdf:type><owl:versionInfo xmlns:owl="http://www.w3.org/2002/07/owl#">2.2.0</owl:versionInfo></rdf:Description></rdf:RDF>
