3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">assessment property</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#assessmentResult"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Links an observation assessment to its structured result when one exists.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">assessment result</rdfs:label><rdfs:range xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro#ObservationResult"></rdfs:range></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#assessmentSensor"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Identifies the sensor used or considered by an observation assessment.</rdfs:comment><rdfs:isDefinedBy xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://w3id.org/modavis/omaro/ontology"></rdfs:isDefinedBy><rdfs:label xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">assessment sensor</rdfs:label></rdf:Description><rdf:Description rdf:about="https://w3id.org/modavis/omaro#assessmentStatus"><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"></rdf:type><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></rdf:type><rdfs:comment xmlns:rdfs="h