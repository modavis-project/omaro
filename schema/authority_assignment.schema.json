{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/modavis/omaro/schema/authority_assignment.schema.json",
  "title": "Documented authority mandate",
  "type": "object", "additionalProperties": false,
  "required": ["uri", "agent_uri", "represented_community_uri", "authority_role", "authority_basis_uri", "conferred_by_agent_uri", "subject_matter_uris", "covered_validation_dimensions", "covered_action_uris", "applicability_scope_uris", "valid_from", "valid_until", "delegation_permitted", "status", "revocation_event_uri", "revocation_effect", "rights_uri", "evidence"],
  "properties": {
    "uri": {"type": "string", "format": "uri"}, "agent_uri": {"type": "string", "format": "uri"},
    "represented_community_uri": {"type": ["string", "null"], "format": "uri"},
    "authority_role": {"enum": ["community-reviewer", "cultural-authority", "language-authority", "rights-authority", "delegated-representative", "organology-reviewer", "historical-reviewer", "technical-reviewer", "ethical-reviewer"]},
    "authority_basis_uri": {"type": "string", "format": "uri"},
    "conferred_by_agent_uri": {"type": "string", "format": "uri"},
    "subject_matter_uris": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
    "covered_validation_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["referential", "linguistic", "community", "historical", "scholarly", "ethical", "rights"]}},
    "covered_action_uris": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
    "applicability_scope_uris": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
    "valid_from": {"type": "string", "format": "date-time"}, "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "delegation_permitted": {"type": "boolean"}, "status": {"enum": ["active", "expired", "revoked", "withdrawn"]},
    "revocation_event_uri": {"type": ["string", "null"], "format": "uri"},
    "revocation_effect": {"enum": ["prospective", "retroactive", null]},
    "rights_uri": {"type": "string", "format": "uri"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {"evidence": {"type": "object", "additionalProperties": false, "required": ["citation", "evidence_type", "relation", "resource_uri", "note"], "properties": {"citation": {"type": "string", "minLength": 1}, "evidence_type": {"enum": ["community-decision", "rights-protocol", "source-record"]}, "relation": {"enum": ["supports", "opposes", "qualifies", "documents"]}, "resource_uri": {"type": ["string", "null"], "format": "uri"}, "note": {"type": ["string", "null"]}}}}
}
