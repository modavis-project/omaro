{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/modavis/omaro/schema/concept_relation_assertion.schema.json",
  "title": "Qualified hierarchy or cross-scheme mapping assertion",
  "type": "object", "additionalProperties": false,
  "required": ["uri", "subject_concept_uri", "predicate_uri", "object_concept_uri", "assigned_by_uri", "generated_by_uri", "perspective_uri", "relation_method_uri", "mapping_purpose_uris", "stance", "applicability_scope_uris", "evidence", "authority_assignment_uris", "valid_from", "valid_until", "projection_policy_uris", "source_record_uri", "assertion_origin"],
  "properties": {
    "uri": {"type": "string", "format": "uri"}, "subject_concept_uri": {"type": "string", "format": "uri"},
    "predicate_uri": {"enum": ["http://www.w3.org/2004/02/skos/core#broader", "http://www.w3.org/2004/02/skos/core#narrower", "http://www.w3.org/2004/02/skos/core#related", "http://www.w3.org/2004/02/skos/core#exactMatch", "http://www.w3.org/2004/02/skos/core#closeMatch", "http://www.w3.org/2004/02/skos/core#broadMatch", "http://www.w3.org/2004/02/skos/core#narrowMatch", "http://www.w3.org/2004/02/skos/core#relatedMatch"]},
    "object_concept_uri": {"type": "string", "format": "uri"}, "assigned_by_uri": {"type": "string", "format": "uri"},
    "generated_by_uri": {"type": ["string", "null"], "format": "uri"}, "perspective_uri": {"type": "string", "format": "uri"},
    "relation_method_uri": {"type": "string", "format": "uri"},
    "mapping_purpose_uris": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
    "stance": {"enum": ["source-asserted", "asserted", "proposed", "endorsed", "disputed", "rejected", "superseded"]},
    "applicability_scope_uris": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "authority_assignment_uris": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "projection_policy_uris": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
    "source_record_uri": {"type": "string", "format": "uri"}, "assertion_origin": {"enum": ["source-derived", "project-asserted", "scholarly-asserted", "community-asserted"]}
  },
  "allOf": [
    {
      "if": {"properties": {"predicate_uri": {"enum": ["http://www.w3.org/2004/02/skos/core#exactMatch", "http://www.w3.org/2004/02/skos/core#closeMatch", "http://www.w3.org/2004/02/skos/core#broadMatch", "http://www.w3.org/2004/02/skos/core#narrowMatch", "http://www.w3.org/2004/02/skos/core#relatedMatch"]}}},
      "then": {"properties": {"mapping_purpose_uris": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"predicate_uri": {"enum": ["http://www.w3.org/2004/02/skos/core#broader", "http://www.w3.org/2004/02/skos/core#narrower", "http://www.w3.org/2004/02/skos/core#related"]}}},
      "then": {"properties": {"mapping_purpose_uris": {"maxItems": 0}}}
    }
  ],
  "$defs": {"evidence": {"type": "object", "additionalProperties": false, "required": ["citation", "evidence_type", "relation", "resource_uri", "note"], "properties": {"citation": {"type": "string", "minLength": 1}, "evidence_type": {"enum": ["source-record", "fieldwork", "community-decision", "linguistic-analysis", "scholarly-publication", "rights-protocol", "observation", "reasoning"]}, "relation": {"enum": ["supports", "opposes", "qualifies", "documents"]}, "resource_uri": {"type": ["string", "null"], "format": "uri"}, "note": {"type": ["string", "null"]}}}}
}
