{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/modavis/omaro/schema/projection_policy.schema.json",
  "title": "Named claim projection policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uri", "label", "description", "graph_role", "direct_assertion",
    "eligible_stances", "review_requirements", "minimum_independent_reviewers",
    "veto_rules", "context_match_required", "unknown_scope_behavior",
    "includes_source_layer", "policy_version"
  ],
  "properties": {
    "uri": {"type": "string", "format": "uri"},
    "label": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "graph_role": {"enum": ["source", "claims", "endorsed", "public"]},
    "direct_assertion": {"type": "boolean"},
    "eligible_stances": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["source-asserted", "asserted", "proposed", "endorsed", "disputed", "rejected", "superseded"]}
    },
    "review_requirements": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/reviewRequirement"}
    },
    "minimum_independent_reviewers": {"type": "integer", "minimum": 0},
    "veto_rules": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/vetoRule"}
    },
    "context_match_required": {"type": "boolean"},
    "unknown_scope_behavior": {"enum": ["include", "exclude", "warn"]},
    "includes_source_layer": {"type": "boolean"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
  },
  "$defs": {
    "reviewerAuthority": {
      "enum": ["community", "language", "organology", "history", "rights", "technical", "ethical"]
    },
    "validationDimension": {
      "enum": ["referential", "linguistic", "community", "historical", "scholarly", "ethical", "rights"]
    },
    "reviewOutcome": {
      "enum": ["accepted", "correction", "disputed", "rejected", "unverifiable", "withdrawn"]
    },
    "reviewRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_dimension", "reviewer_authorities", "outcomes", "minimum_independent_reviewers"],
      "properties": {
        "validation_dimension": {"$ref": "#/$defs/validationDimension"},
        "reviewer_authorities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reviewerAuthority"}},
        "outcomes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reviewOutcome"}},
        "minimum_independent_reviewers": {"type": "integer", "minimum": 1}
      }
    },
    "vetoRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_dimensions", "reviewer_authorities", "outcomes"],
      "properties": {
        "validation_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/validationDimension"}},
        "reviewer_authorities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reviewerAuthority"}},
        "outcomes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reviewOutcome"}}
      }
    }
  }
}
