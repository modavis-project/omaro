{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/modavis/omaro/schema/classification_criterion.schema.json",
  "title": "Organological classification criterion",
  "description": "A governed and versionable description of an organological basis used by a classification assignment. It identifies observable properties and a documented inference logic without confusing the criterion with an observation or conclusion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uri", "label", "description", "criterion_type", "observable_property_uris",
    "procedure_uris", "classification_scheme_uri", "scheme_version_uri",
    "conclusion_classification_uris", "inference_logic_uri", "asserted_by_uri",
    "perspective_uri", "source_record_uri", "evidence", "rights_uri", "status",
    "applicability_scope_uris", "authority_assignment_uris",
    "protocol_application_uris"
  ],
  "properties": {
    "uri": {"type": "string", "format": "uri"},
    "label": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "criterion_type": {
      "enum": [
        "primary-vibrator", "excitation-mechanism", "active-sound-source",
        "resonator", "sympathetic-vibrator", "sound-propagation", "construction", "material",
        "bore-profile", "pitch-control", "tuning-range", "controller-interface",
        "timbre-modifier", "signal-generator", "signal-processor", "amplifier",
        "transducer", "radiator", "physical-configuration", "actual-technique",
        "performer-instrument-relation", "acoustic-property", "manufacture",
        "visual-design", "ensemble-or-repertoire-role", "historical-provenance",
        "geographic-distribution", "social-or-ritual-function", "symbolic-meaning",
        "intended-function", "actual-use", "community-category", "other"
      ]
    },
    "observable_property_uris": {"$ref": "#/$defs/uriArray"},
    "procedure_uris": {"$ref": "#/$defs/uriArray"},
    "classification_scheme_uri": {"type": "string", "format": "uri"},
    "scheme_version_uri": {"type": ["string", "null"], "format": "uri"},
    "conclusion_classification_uris": {"$ref": "#/$defs/uriArray"},
    "inference_logic_uri": {"type": ["string", "null"], "format": "uri"},
    "asserted_by_uri": {"type": "string", "format": "uri"},
    "perspective_uri": {"type": "string", "format": "uri"},
    "applicability_scope_uris": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "format": "uri"}
    },
    "authority_assignment_uris": {"$ref": "#/$defs/uriArray"},
    "protocol_application_uris": {"$ref": "#/$defs/uriArray"},
    "source_record_uri": {"type": ["string", "null"], "format": "uri"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "rights_uri": {"type": "string", "format": "uri"},
    "status": {"enum": ["draft", "active", "deprecated", "withdrawn"]}
  },
  "$defs": {
    "uriArray": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "format": "uri"}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["citation", "evidence_type", "relation", "resource_uri", "note"],
      "properties": {
        "citation": {"type": "string", "minLength": 1},
        "evidence_type": {"enum": ["source-record", "fieldwork", "community-decision", "linguistic-analysis", "scholarly-publication", "rights-protocol", "observation", "reasoning"]},
        "relation": {"enum": ["supports", "opposes", "qualifies", "documents"]},
        "resource_uri": {"type": ["string", "null"], "format": "uri"},
        "note": {"type": ["string", "null"]}
      }
    }
  }
}
