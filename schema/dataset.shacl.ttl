@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skosxl: <http://www.w3.org/2008/05/skos-xl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix crmsci: <http://www.cidoc-crm.org/extensions/crmsci/> .
@prefix omaro: <https://w3id.org/modavis/omaro#> .

<#ConceptShape>
    a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] .

<#ResolvedLabelShape>
    a sh:NodeShape ;
    sh:targetSubjectsOf skos:prefLabel ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:uniqueLang true ;
        sh:disjoint skos:altLabel ;
        sh:disjoint skos:hiddenLabel ;
        sh:nodeKind sh:Literal
    ] .

<#AlternateLabelDisjointnessShape>
    a sh:NodeShape ;
    sh:targetSubjectsOf skos:altLabel ;
    sh:property [
        sh:path skos:altLabel ;
        sh:disjoint skos:hiddenLabel ;
        sh:nodeKind sh:Literal
    ] .

<#SkosXlLabelShape>
    a sh:NodeShape ;
    sh:targetClass skosxl:Label ;
    sh:property [
        sh:path skosxl:literalForm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path omaro:labelProfile ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class omaro:LabelProfile ;
        sh:nodeKind sh:IRI
    ] .

<#LabelProfileShape>
    a sh:NodeShape ;
    sh:targetClass omaro:LabelProfile ;
    sh:property [
        sh:path omaro:labelResource ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skosxl:Label ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:sourceLabelAssertion ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class omaro:LabelAssertion ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path dcterms:language ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path omaro:primaryLanguageSubtag ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path omaro:scriptRegistry ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class prov:Entity ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:translationStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ("unverified" "borrowed-translingual" "machine-translated" "human-translated" "native-speaker-reviewed" "community-reviewed" "contested" "not-applicable")
    ] ;
    sh:property [
        sh:path omaro:assertionOrigin ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "source-derived"
    ] ;
    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class omaro:LabelAssertion ;
        sh:nodeKind sh:IRI
    ] .

<#SkosXlPreferredLabelShape>
    a sh:NodeShape ;
    sh:targetSubjectsOf skosxl:prefLabel ;
    sh:property [
        sh:path skosxl:prefLabel ;
        sh:class skosxl:Label ;
        sh:nodeKind sh:IRI
    ] .

<#BroaderShape>
    a sh:NodeShape ;
    sh:targetSubjectsOf skos:broader ;
    sh:property [
        sh:path skos:broader ;
        sh:class skos:Concept ;
        sh:nodeKind sh:IRI
    ] .

<#NoUnqualifiedExactMatchShape>
    a sh:NodeShape ;
    sh:targetSubjectsOf skos:exactMatch ;
    sh:property [
        sh:path skos:exactMatch ;
        sh:maxCount 0
    ] .

<#ClassificationAssertionShape>
    a sh:NodeShape ;
    sh:targetClass omaro:ClassificationAssertion ;
    sh:property [
        sh:path rdf:subject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path rdf:predicate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue omaro:classifiedAs
    ] ;
    sh:property [
        sh:path rdf:object ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class omaro:ClassificationAssignment ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:classificationScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:ConceptScheme ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:schemeVersion ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:perspective ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class omaro:Perspective ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:targetType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:sparql [
        sh:message "Classification assertion target type does not match the registered organological target kind." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this WHERE {
                $this rdf:subject ?target ; omaro:targetType ?targetType .
                ?target a omaro:OrganologicalTarget ; omaro:targetKind ?targetKind .
                FILTER (?targetType != ?targetKind)
            }
        """
    ] ;
    sh:property [
        sh:path omaro:stance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:hasApplicabilityScope ;
        sh:minCount 1 ;
        sh:class omaro:ApplicabilityScope ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:underProjectionPolicy ;
        sh:minCount 1 ;
        sh:class omaro:ProjectionPolicy ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:hasEvidence ;
        sh:minCount 1 ;
        sh:class omaro:Evidence ;
        sh:nodeKind sh:IRI
    ] ;
    sh:sparql [
        sh:message "Classification validity ends before it begins." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            SELECT $this WHERE {
                $this omaro:validFrom ?start ; omaro:validUntil ?end .
                FILTER (?end < ?start)
            }
        """
    ] ;
    sh:sparql [
        sh:message "A classification assertion and its compound expression must use the same perspective." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            SELECT $this WHERE {
                $this prov:wasGeneratedBy/omaro:classificationExpression ?expression ;
                      omaro:perspective ?assertionPerspective .
                ?expression omaro:perspective ?expressionPerspective .
                FILTER (?assertionPerspective != ?expressionPerspective)
            }
        """
    ] ;
    sh:sparql [
        sh:message "A classification assertion and its compound expression must use exactly the same scheme version, including an omitted version." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            SELECT $this WHERE {
                $this prov:wasGeneratedBy/omaro:classificationExpression ?expression .
                {
                    $this omaro:schemeVersion ?version .
                    FILTER NOT EXISTS { ?expression omaro:schemeVersion ?version }
                }
                UNION
                {
                    ?expression omaro:schemeVersion ?version .
                    FILTER NOT EXISTS { $this omaro:schemeVersion ?version }
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every classification-assertion scope must be covered by its compound expression." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            SELECT $this WHERE {
                $this prov:wasGeneratedBy/omaro:classificationExpression ?expression ;
                      omaro:hasApplicabilityScope ?scope .
                FILTER NOT EXISTS { ?expression omaro:hasApplicabilityScope ?scope }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every classified expression member must belong to the assertion's classification scheme." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this WHERE {
                $this prov:wasGeneratedBy/omaro:classificationExpression/
                          omaro:hasExpressionMember/omaro:memberClassification ?memberClass ;
                      omaro:classificationScheme ?scheme .
                FILTER NOT EXISTS { ?memberClass skos:inScheme ?scheme }
            }
        """
    ] ;
    sh:sparql [
        sh:message "When an expression preserves a source concept, a linked assertion must classify as that concept." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this WHERE {
                $this prov:wasGeneratedBy/omaro:classificationExpression ?expression ;
                      rdf:object ?assertedClass .
                ?sourceConcept a skos:Concept ;
                               omaro:classificationExpression ?expression .
                FILTER (?assertedClass != ?sourceConcept)
            }
        """
    ] ;
    sh:sparql [
        sh:message "A registered expression-member target must be connected to the registered whole-assertion target." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this WHERE {
                $this rdf:subject ?wholeTarget ;
                      prov:wasGeneratedBy/omaro:classificationExpression/
                          omaro:hasExpressionMember/omaro:memberTarget ?memberTarget .
                ?wholeTarget omaro:targetKind ?wholeTargetKind .
                ?memberTarget omaro:targetKind ?memberTargetKind .
                FILTER (
                    ?wholeTarget != ?memberTarget &&
                    NOT EXISTS {
                        ?wholeTarget (
                            omaro:configurationOf | ^omaro:configurationOf |
                            omaro:componentOf | ^omaro:componentOf |
                            omaro:conditionStateOf | ^omaro:conditionStateOf |
                            omaro:performanceEvent | ^omaro:performanceEvent |
                            omaro:hasComponent | ^omaro:hasComponent |
                            omaro:hasFunctionalModule | ^omaro:hasFunctionalModule
                        )+ ?memberTarget
                    }
                )
            }
        """
    ] .

<#ActivityEntitySeparationShape>
    a sh:NodeShape ;
    sh:targetClass omaro:ClassificationAssignment, omaro:ReviewEvent ;
    sh:message "An assignment or review activity cannot also be an assertion or review-decision entity." ;
    sh:not [
        sh:or (
            [ sh:class omaro:ClassificationAssertion ]
            [ sh:class omaro:ConceptRelationAssertion ]
            [ sh:class omaro:LabelAssertion ]
            [ sh:class omaro:NoteAssertion ]
            [ sh:class omaro:ReviewDecision ]
        )
    ] .

<#ClassificationAssignmentShape>
    a sh:NodeShape ;
    sh:targetClass omaro:ClassificationAssignment ;
    sh:property [
        sh:path prov:generated ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class omaro:ClassificationAssertion ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path prov:wasAssociatedWith ;
        sh:minCount 1 ;
        sh:class prov:Agent ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:classificationMethod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:usedAssessment ;
        sh:class omaro:ObservationAssessment ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:usedObservation ;
        sh:class omaro:OrganologicalObservation ;
        sh:nodeKind sh:IRI
    ] .

<#LexicalAndNoteAssertionShape>
    a sh:NodeShape ;
    sh:targetClass omaro:LabelAssertion, omaro:NoteAssertion ;
    sh:property [
        sh:path rdf:subject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path rdf:predicate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path rdf:object ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path prov:wasAttributedTo ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class prov:Agent ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:sourceRecord ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class prov:Entity ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:assertionOrigin ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "source-asserted"
    ] ;
    sh:property [
        sh:path omaro:reviewStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ("unreviewed" "accepted" "disputed" "rejected" "superseded")
    ] ;
    sh:property [
        sh:path omaro:reviewStatusResource ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class omaro:ReviewStatus ;
        sh:nodeKind sh:IRI
    ] .

<#LabelAssertionPredicateShape>
    a sh:NodeShape ;
    sh:targetClass omaro:LabelAssertion ;
    sh:property [
        sh:path rdf:predicate ;
        sh:in (skos:prefLabel skos:altLabel skos:hiddenLabel)
    ] ;
    sh:property [
        sh:path omaro:labelResource ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skosxl:Label ;
        sh:nodeKind sh:IRI
    ] .

<#NoteAssertionPredicateShape>
    a sh:NodeShape ;
    sh:targetClass omaro:NoteAssertion ;
    sh:property [
        sh:path rdf:predicate ;
        sh:in (
            skos:definition
            skos:scopeNote
            skos:historyNote
            skos:editorialNote
            skos:changeNote
            skos:example
        )
    ] .

<#ConceptSchemeShape>
    a sh:NodeShape ;
    # schemeType identifies registered classification or terminology schemes.
    # OMARO's generated controlled-code schemes intentionally omit this property.
    sh:targetSubjectsOf omaro:schemeType ;
    sh:class skos:ConceptScheme ;
    sh:property [
        sh:path omaro:schemePerspective ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class omaro:Perspective ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path prov:wasAttributedTo ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class prov:Agent ;
        sh:nodeKind sh:IRI
    ] .

<#PerspectiveShape>
    a sh:NodeShape ;
    sh:targetClass omaro:Perspective ;
    sh:property [
        sh:path omaro:heldBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class prov:Agent ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:perspectiveType ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path omaro:assignmentStatus ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "Perspective validity ends before it begins." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            SELECT $this WHERE {
                $this omaro:validFrom ?start ; omaro:validUntil ?end .
                FILTER (?end < ?start)
            }
        """
    ] .

<#ApplicabilityScopeShape>
    a sh:NodeShape ;
    sh:targetClass omaro:ApplicabilityScope ;
    sh:property [
        sh:path omaro:scopeMode ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:nodeKind sh:IRI ;
        sh:in (
            omaro:scope-mode-source-silent
            omaro:scope-mode-not-yet-investigated
            omaro:scope-mode-known-unknown
            omaro:scope-mode-intentionally-unscoped
            omaro:scope-mode-not-applicable
            omaro:scope-mode-specified
            omaro:scope-mode-context-independent
        )
    ] ;
    sh:property [
        sh:path prov:wasAttributedTo ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class prov:Agent ;
        sh:nodeKind sh:IRI
    ] ;
    sh:sparql [
        sh:message "Applicability-scope interval ends before it begins." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            SELECT $this WHERE {
                $this omaro:temporalStart ?start ; omaro:temporalEnd ?end .
                FILTER (?end < ?start)
            }
        """
    ] .

<#ProjectionPolicyShape>
    a sh:NodeShape ;
    sh:targetClass omaro:ProjectionPolicy ;
    sh:property [
        sh:path omaro:graphRole ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path omaro:directAssertion ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path omaro:unknownScopeBehavior ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ("include" "warn" "exclude")
    ] ;
    sh:property [
        sh:path omaro:policyVersion ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<#EvidenceShape>
    a sh:NodeShape ;
    sh:targetClass omaro:Evidence ;
    sh:property [
        sh:path dcterms:bibliographicCitation ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path omaro:evidenceType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:evidenceRelation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] .

<#AuthorityAssignmentShape>
    a sh:NodeShape ;
    sh:targetClass omaro:AuthorityAssignment ;
    sh:property [
        sh:path omaro:assignedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class prov:Agent ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:representsCommunity ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:authorityRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:authorityBasis ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:conferredBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class prov:Agent ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:subjectMatter ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:coveredValidationDimension ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path omaro:coveredAction ;
        sh:class skos:Concept ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:hasApplicabilityScope ;
        sh:minCount 1 ;
        sh:class omaro:ApplicabilityScope ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:hasEvidence ;
        sh:minCount 1 ;
        sh:class omaro:Evidence ;
        sh:nodeKind sh:IRI
    ] ;
    sh:sparql [
        sh:message "Authority validity ends before it begins." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            SELECT $this WHERE {
                $this omaro:validFrom ?start ; omaro:validUntil ?end .
                FILTER (?end < ?start)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Community authority roles and represented-community links must occur together." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            SELECT $this WHERE {
                {
                    $this omaro:authorityRole ?role .
                    FILTER (?role IN (
                        omaro:authority-role-community-reviewer,
                        omaro:authority-role-cultural-authority,
                        omaro:authority-role-delegated-representative
                    ))
                    FILTER NOT EXISTS { $this omaro:representsCommunity ?community }
                }
                UNION
                {
                    $this omaro:authorityRole ?role ; omaro:representsCommunity ?community .
                    FILTER (?role NOT IN (
                        omaro:authority-role-community-reviewer,
                        omaro:authority-role-cultural-authority,
                        omaro:authority-role-delegated-representative
                    ))
                }
            }
        """
    ] .

<#ReviewEventShape>
    a sh:NodeShape ;
    sh:targetClass omaro:ReviewEvent ;
    sh:property [
        sh:path omaro:reviewDecision ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class omaro:ReviewDecision ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path prov:wasAssociatedWith ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class prov:Agent ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:authorityAssignment ;
        sh:minCount 1 ;
        sh:class omaro:AuthorityAssignment ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:reviewerAuthority ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:reviewMethod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] .

<#ReviewDecisionShape>
    a sh:NodeShape ;
    sh:targetClass omaro:ReviewDecision ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class omaro:ReviewEvent ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:targetAssertion ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:perspective ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class omaro:Perspective ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:hasApplicabilityScope ;
        sh:minCount 1 ;
        sh:class omaro:ApplicabilityScope ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:reviewOutcome ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:validationDimension ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:decisionStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:underProjectionPolicy ;
        sh:minCount 1 ;
        sh:class omaro:ProjectionPolicy ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:hasEvidence ;
        sh:minCount 1 ;
        sh:class omaro:Evidence ;
        sh:nodeKind sh:IRI
    ] ;
    sh:sparql [
        sh:message "Review validity ends before the review decision." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            SELECT $this WHERE {
                $this prov:wasGeneratedBy/prov:endedAtTime ?start ;
                    omaro:validUntil ?end .
                FILTER (?end < ?start)
            }
        """
    ] ;
    sh:sparql [
        sh:message "A review decision may perform at most one predecessor lifecycle action." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            SELECT $this WHERE {
                {
                    SELECT $this (COUNT(?previous) AS ?count) WHERE {
                        $this ?path ?previous .
                        FILTER (?path IN (
                            omaro:supersedesDecision,
                            omaro:suspendsDecision,
                            omaro:reinstatesDecision
                        ))
                    } GROUP BY $this
                }
                FILTER (?count > 1)
            }
        """
    ] ;
    sh:sparql [
        sh:message "A review lifecycle action must target an older decision for the same assertion." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            SELECT $this WHERE {
                $this ?path ?previous ;
                    omaro:targetAssertion ?target ;
                    prov:wasGeneratedBy/prov:endedAtTime ?time .
                FILTER (?path IN (
                    omaro:supersedesDecision,
                    omaro:suspendsDecision,
                    omaro:reinstatesDecision
                ))
                OPTIONAL { ?previous omaro:targetAssertion ?previousTarget }
                OPTIONAL { ?previous prov:wasGeneratedBy/prov:endedAtTime ?previousTime }
                FILTER (
                    !BOUND(?previousTarget) || !BOUND(?previousTime) ||
                    ?previousTarget != ?target || ?previousTime >= ?time
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "A temporary review suspension must declare its end time." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            SELECT $this WHERE {
                $this omaro:suspendsDecision ?previous .
                FILTER NOT EXISTS { $this omaro:validUntil ?end }
            }
        """
    ] .

<#ConceptRelationAssertionShape>
    a sh:NodeShape ;
    sh:targetClass omaro:ConceptRelationAssertion ;
    sh:property [
        sh:path rdf:subject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path rdf:predicate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path rdf:object ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:perspective ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class omaro:Perspective ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:hasApplicabilityScope ;
        sh:minCount 1 ;
        sh:class omaro:ApplicabilityScope ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:underProjectionPolicy ;
        sh:minCount 1 ;
        sh:class omaro:ProjectionPolicy ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:hasEvidence ;
        sh:minCount 1 ;
        sh:class omaro:Evidence ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:mappingPurpose ;
        sh:nodeKind sh:IRI
    ] ;
    sh:sparql [
        sh:message "A SKOS mapping assertion requires at least one mapping purpose." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this WHERE {
                $this rdf:predicate ?predicate .
                FILTER (?predicate IN (
                    skos:exactMatch, skos:closeMatch, skos:broadMatch,
                    skos:narrowMatch, skos:relatedMatch
                ))
                FILTER NOT EXISTS { $this omaro:mappingPurpose ?purpose }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A structural SKOS relation must not declare a mapping purpose." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this WHERE {
                $this rdf:predicate ?predicate ; omaro:mappingPurpose ?purpose .
                FILTER (?predicate IN (skos:broader, skos:narrower, skos:related))
            }
        """
    ] ;
    sh:sparql [
        sh:message "Concept-relation validity ends before it begins." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            SELECT $this WHERE {
                $this omaro:validFrom ?start ; omaro:validUntil ?end .
                FILTER (?end < ?start)
            }
        """
    ] .

<#OrganologicalTargetShape>
    a sh:NodeShape ;
