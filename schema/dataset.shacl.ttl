        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:hasComponent ;
        sh:class omaro:OrganologicalTarget ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path dcterms:rights ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:authorityAssignment ;
        sh:class omaro:AuthorityAssignment ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:protocolApplication ;
        sh:class omaro:ProtocolApplication ;
        sh:nodeKind sh:IRI
    ] ;
    sh:sparql [
        sh:message "An organological target state ends before it begins." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            SELECT $this WHERE {
                $this omaro:validFrom ?start ; omaro:validUntil ?end .
                FILTER (?end < ?start)
            }
        """
    ] .

<#ClassificationCriterionShape>
