<#ObservationAssessmentShape>
    a sh:NodeShape ;
    sh:targetClass omaro:ObservationAssessment ;
    sh:property [
        sh:path omaro:assessmentFeatureOfInterest ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:assessmentProperty ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:assessmentProcedure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:assessmentResult ;
        sh:maxCount 1 ;
        sh:class omaro:ObservationResult ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:assessmentTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime
    ] ;
    sh:property [
        sh:path omaro:assessmentAgent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class prov:Agent ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:assessmentStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:perspective ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class omaro:Perspective ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:hasApplicabilityScope ;
        sh:minCount 1 ;
        sh:class omaro:ApplicabilityScope ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:reviewStatusResource ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class omaro:ReviewStatus ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path dcterms:rights ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:authorityAssignment ;
        sh:class omaro:AuthorityAssignment ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:protocolApplication ;
        sh:class omaro:ProtocolApplication ;
        sh:nodeKind sh:IRI
    ] ;
    sh:sparql [
        sh:message "A detected or not-detected observation must have exactly one result." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            SELECT $this WHERE {
                $this omaro:assessmentStatus ?status .
                FILTER (?status IN (
                    omaro:assessment-status-detected,
                    omaro:assessment-status-not-detected
                ))
                FILTER NOT EXISTS { $this omaro:assessmentResult ?result }
            }
        """
    ] ;
    sh:sparql [
        sh:message "An actual observation status must identify an organological observation activity." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this WHERE {
                $this omaro:assessmentStatus ?status .
                FILTER (?status IN (
                    omaro:assessment-status-detected,
                    omaro:assessment-status-not-detected,
                    omaro:assessment-status-indeterminate
                ))
                FILTER NOT EXISTS { $this rdf:type omaro:OrganologicalObservation }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A non-observation or non-applicability assessment must not have a result." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            SELECT $this WHERE {
                $this omaro:assessmentStatus ?status ;
                    omaro:assessmentResult ?result .
                FILTER (?status IN (
                    omaro:assessment-status-not-observed,
                    omaro:assessment-status-not-applicable
                ))
            }
        """
    ] ;
    sh:sparql [
        sh:message "A non-observation or non-applicability assessment must not be typed as an observation activity." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sosa: <http://www.w3.org/ns/sosa/>
            PREFIX crmsci: <http://www.cidoc-crm.org/extensions/crmsci/>
            SELECT $this WHERE {
                $this omaro:assessmentStatus ?status ; rdf:type ?observationType .
                FILTER (?status IN (
                    omaro:assessment-status-not-observed,
                    omaro:assessment-status-not-applicable
                ))
                FILTER (?observationType IN (
                    omaro:OrganologicalObservation,
                    sosa:Observation,
                    crmsci:S27_Observation
                ))
            }
        """
    ] ;
    sh:sparql [
        sh:message "A non-observation or non-applicability assessment must not use SOSA observation properties." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            PREFIX sosa: <http://www.w3.org/ns/sosa/>
            SELECT $this WHERE {
                $this omaro:assessmentStatus ?status ;
                    ?observationProperty ?value .
                FILTER (?status IN (
                    omaro:assessment-status-not-observed,
                    omaro:assessment-status-not-applicable
                ))
                FILTER (?observationProperty IN (
                    sosa:hasFeatureOfInterest,
                    sosa:observedProperty,
                    sosa:usedProcedure,
                    sosa:madeBySensor,
                    sosa:resultTime,
                    sosa:hasResult
                ))
            }
        """
    ] .

<#ActualOrganologicalObservationShape>
    a sh:NodeShape ;
    sh:targetClass omaro:OrganologicalObservation ;
    sh:property [
        sh:path sosa:hasFeatureOfInterest ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path sosa:observedProperty ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path sosa:usedProcedure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path sosa:resultTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime
    ] .

<#ObservationResultShape>
    a sh:NodeShape ;
    sh:targetClass omaro:ObservationResult ;
    sh:property [
        sh:path omaro:resultKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:nodeKind sh:IRI
    ] ;
    sh:sparql [
        sh:message "An observation range has its maximum below its minimum." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            SELECT $this WHERE {
                $this omaro:minimumValue ?minimum ; omaro:maximumValue ?maximum .
                FILTER (?maximum < ?minimum)
            }
        """
    ] .

<#ClassificationExpressionShape>
    a sh:NodeShape ;
    sh:targetClass omaro:ClassificationExpression ;
    sh:property [
        sh:path omaro:notationLiteral ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path omaro:notationGrammar ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:schemeVersion ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:combinationOperator ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:parseStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:hasExpressionMember ;
        sh:minCount 2 ;
        sh:class omaro:ClassificationExpressionMember ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:perspective ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class omaro:Perspective ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:hasApplicabilityScope ;
        sh:minCount 1 ;
        sh:class omaro:ApplicabilityScope ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:hasEvidence ;
        sh:minCount 1 ;
        sh:class omaro:Evidence ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path dcterms:rights ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:authorityAssignment ;
        sh:class omaro:AuthorityAssignment ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:protocolApplication ;
        sh:class omaro:ProtocolApplication ;
        sh:nodeKind sh:IRI
    ] ;
    sh:sparql [
        sh:message "An expression member that cites an assertion must also state its classification and target." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            SELECT $this WHERE {
                $this omaro:hasExpressionMember ?member .
                ?member omaro:memberAssertion ?memberAssertion .
                {
                    FILTER NOT EXISTS {
                        ?member omaro:memberClassification ?memberClass
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS { ?member omaro:memberTarget ?memberTarget }
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "An expression member's classification and target must equal those of its cited assertion." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this WHERE {
                $this omaro:hasExpressionMember ?member .
                ?member omaro:memberAssertion ?memberAssertion ;
                        omaro:memberClassification ?memberClass ;
                        omaro:memberTarget ?memberTarget .
                ?memberAssertion rdf:object ?assertedClass ;
                                 rdf:subject ?assertedTarget .
                FILTER (
                    ?memberClass != ?assertedClass ||
                    ?memberTarget != ?assertedTarget
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "An expression and its cited member assertions must use the same perspective." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            SELECT $this WHERE {
                $this omaro:perspective ?expressionPerspective ;
                      omaro:hasExpressionMember/omaro:memberAssertion ?memberAssertion .
                ?memberAssertion omaro:perspective ?assertionPerspective .
                FILTER (?expressionPerspective != ?assertionPerspective)
            }
        """
    ] ;
    sh:sparql [
        sh:message "An expression and its cited member assertions must use exactly the same scheme version, including an omitted version." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            SELECT $this WHERE {
                $this omaro:hasExpressionMember/omaro:memberAssertion ?memberAssertion .
                {
                    $this omaro:schemeVersion ?version .
                    FILTER NOT EXISTS { ?memberAssertion omaro:schemeVersion ?version }
                }
                UNION
                {
                    ?memberAssertion omaro:schemeVersion ?version .
                    FILTER NOT EXISTS { $this omaro:schemeVersion ?version }
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every expression scope must be covered by each cited member assertion." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            SELECT $this WHERE {
                $this omaro:hasApplicabilityScope ?scope ;
                      omaro:hasExpressionMember/omaro:memberAssertion ?memberAssertion .
                FILTER NOT EXISTS {
                    ?memberAssertion omaro:hasApplicabilityScope ?scope
                }
            }
        """
    ] .

<#ClassificationExpressionMemberShape>
    a sh:NodeShape ;
    sh:targetClass omaro:ClassificationExpressionMember ;
    sh:property [
        sh:path omaro:sequenceIndex ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1
    ] ;
    sh:property [
        sh:path omaro:memberNotation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path omaro:memberClassification ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:memberAssertion ;
        sh:maxCount 1 ;
        sh:class omaro:ClassificationAssertion ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:memberTarget ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:componentRole ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path omaro:localSuffixNotation ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal
    ] ;
    sh:sparql [
        sh:message "A stated expression-member role must equal the role on its registered target." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            SELECT $this WHERE {
                $this omaro:memberTarget ?memberTarget ;
                      omaro:componentRole ?memberRole .
                ?memberTarget omaro:targetKind ?memberTargetKind .
                FILTER NOT EXISTS { ?memberTarget omaro:componentRole ?memberRole }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Under the MIMO Hornbostel-Sachs plus grammar, a member token must equal its class notation or extend it with a hyphen suffix." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this WHERE {
                ?expression omaro:notationGrammar omaro:notation-grammar-mimo-hs-plus ;
                            omaro:hasExpressionMember $this .
                $this omaro:memberNotation ?memberNotation ;
                      omaro:memberClassification ?memberClass .
                ?memberClass skos:notation ?classNotation .
                FILTER (
                    STR(?memberNotation) != STR(?classNotation) &&
                    !STRSTARTS(
                        STR(?memberNotation),
                        CONCAT(STR(?classNotation), "-")
                    )
                )
            }
        """
    ] .

<#ProtocolApplicationShape>
    a sh:NodeShape ;
    sh:targetClass omaro:ProtocolApplication ;
    sh:property [ sh:path omaro:targetResource ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:protocol ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:protocolType ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:issuedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class prov:Agent ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:appliedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class prov:Agent ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:representsCommunity ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:authorityAssignment ; sh:minCount 1 ; sh:class omaro:AuthorityAssignment ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:hasApplicabilityScope ; sh:minCount 1 ; sh:class omaro:ApplicabilityScope ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:enforcementMode ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:protocolStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:protocolResolutionStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:integrityVerificationMethod ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:validFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:sparql [
        sh:message "A machine-enforceable protocol must use a locally verified artifact and digest." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            SELECT $this WHERE {
                $this omaro:enforcementMode omaro:protocol-enforcement-machine-enforceable .
                FILTER (
                    NOT EXISTS { $this omaro:protocolResolutionStatus omaro:protocol-resolution-verified } ||
                    NOT EXISTS { $this omaro:protocolIntegritySha256 ?digest } ||
                    NOT EXISTS { $this omaro:integrityVerificationMethod omaro:protocol-integrity-method-local-sha256 } ||
                    NOT EXISTS { $this omaro:protocolArtifactPath ?path }
                )
            }
        """
    ] .

<#UseDecisionShape>
    a sh:NodeShape ;
    sh:targetClass omaro:UseDecision ;
    sh:property [ sh:path omaro:targetResource ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:useAction ; sh:minCount 1 ; sh:class skos:Concept ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:useDecision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:useDecisionStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:legalBasisStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:consentStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:legalBasisAssessedBy ; sh:maxCount 1 ; sh:class prov:Agent ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:consentAssessedBy ; sh:maxCount 1 ; sh:class prov:Agent ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:decidedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class prov:Agent ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:decisionMethod ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:authorityAssignment ; sh:minCount 1 ; sh:class omaro:AuthorityAssignment ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path omaro:hasApplicabilityScope ; sh:minCount 1 ; sh:class omaro:ApplicabilityScope ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path prov:generatedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:sparql [
        sh:message "A ready legal-basis or consent status must have a public-safe reference and responsible assessor." ;
        sh:select """
            PREFIX omaro: <https://w3id.org/modavis/omaro#>
            SELECT $this WHERE {
                {
                    $this omaro:legalBasisStatus ?legalStatus .
                    FILTER (?legalStatus IN (
                        omaro:legal-basis-status-documented,
                        omaro:legal-basis-status-not-required
                    ))
                    FILTER (
                        NOT EXISTS { $this omaro:legalBasis ?basis } ||
                        NOT EXISTS { $this omaro:legalBasisAssessedBy ?assessor }
                    )
                }
                UNION
                {
                    $this omaro:consentStatus ?consentStatus .
                    FILTER (?consentStatus IN (
                        omaro:consent-status-documented,
                        omaro:consent-status-not-required
                    ))
                    FILTER (
                        NOT EXISTS { $this omaro:consentRecord ?consent } ||
                        NOT EXISTS { $this omaro:consentAssessedBy ?assessor }
                    )
                }
            }
        """
    ] .
